# ─── Public / Client-side ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://www.qffsrmap2026.com
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Razorpay Payment Gateway
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# ─── Server-side secrets ──────────────────────────────────────────────────────
# Supabase — anon key is public, service role key is SECRET (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# Redis (Upstash) — used for caching, rate limiting, and session whitelisting
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gemini AI
GEMINI_API_KEY=

# Razorpay server-side keys
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CERTIFICATE_PRICE_INR=499

# ─── Session Security ─────────────────────────────────────────────────────────
# REQUIRED in production: generate with `openssl rand -base64 32`
# Must be a cryptographically random string, minimum 32 characters.
# In development, a development-only fallback key is used with a warning.
SESSION_SECRET=

# ─── Qiskit Judge Service ─────────────────────────────────────────────────────
# URL of the Python judge microservice (e.g., http://localhost:8000 or remote service)
QISKIT_JUDGE_URL=
# Shared HMAC secret between Next.js and the judge service (required when QISKIT_JUDGE_URL is set)
# Generate with: openssl rand -base64 32
QISKIT_JUDGE_SECRET=
# Local Python execution (development only)
ENABLE_LOCAL_PYTHON_JUDGE=false
PYTHON_BIN=
# Fallback circuit evaluator (development only, disabled in production)
ENABLE_TYPESCRIPT_JUDGE_FALLBACK=false

# ─── Build / Deployment ───────────────────────────────────────────────────────
BUILD_STANDALONE=false

# ─── Development only ─────────────────────────────────────────────────────────
# Enables local test mode (bypasses Google OAuth).
# MUST be 'false' (or unset) in all deployed/production environments.
# Only works when NODE_ENV=development AND host is loopback (localhost/127.0.0.1).
QFF_LOCAL_TEST_AUTH=false